# Kopieer dit bestand naar /etc/pace-bms.env en vul eigen waarden in.
# Zet dit echte bestand nooit in Git.

PACE_SERIAL_BMS1=/dev/serial/by-path/CHANGE-ME-BMS1
PACE_SERIAL_BMS2=/dev/serial/by-path/CHANGE-ME-BMS2
PACE_SERIAL_BMS3=/dev/serial/by-path/CHANGE-ME-BMS3

PACE_MQTT_HOST=127.0.0.1
PACE_MQTT_PORT=1883
PACE_MQTT_USER=change-me
PACE_MQTT_PASSWORD=change-me
PACE_MQTT_BASE_TOPIC=bmsrs232

PACE_WEB_HOST=0.0.0.0
PACE_WEB_PORT=8080
PACE_HISTORY_DB=/var/lib/pace-bms/pace_history.sqlite3
